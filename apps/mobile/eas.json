{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DEV_AUTH": "1" }
    },
    "preview": { "distribution": "internal", "env": { "EXPO_PUBLIC_DEV_AUTH": "0" } },
    "production": { "autoIncrement": true, "env": { "EXPO_PUBLIC_DEV_AUTH": "0" } }
  },
  "submit": { "production": {} }
}
