# Explicit loopback development only; scripts/dev.mjs sets these defaults.
PRISM_AUTH_MODE=development
PRISM_HOST=127.0.0.1
PRISM_PORT=4000
PRISM_WEB_ORIGIN=http://localhost:3000
PRISM_API_URL=http://127.0.0.1:4000
PRISM_DATA_DIR=.data
PRISM_WORKER_ENABLED=true

# Production: set NODE_ENV=production and PRISM_AUTH_MODE=oidc.
# Provision user, preferences and sync state with the controlled bootstrap command.
# DATABASE_URL=postgresql://prism_runtime:REPLACE@localhost:5432/prism
# REDIS_URL=redis://localhost:6379
# OIDC_ISSUER=https://identity.example/realms/prism
# OIDC_AUDIENCE=prism-api
# OIDC_MOBILE_CLIENT_ID=prism-ios
# OIDC_MOBILE_REDIRECT_URI=prism://auth/callback
# PRISM_ALLOWED_SUBJECT=REPLACE_WITH_ISSUER_SUBJECT
# PRISM_USER_ID=REPLACE_WITH_UUID
# PRISM_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# PRISM_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
# PRISM_PUSH_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY
# PRISM_OIDC_CLIENT_ID=prism-web
# PRISM_OIDC_CLIENT_SECRET=REPLACE_IF_CONFIDENTIAL_CLIENT
# PRISM_OIDC_REDIRECT_URI=https://prism.example/auth/callback
# PRISM_ARXIV_USER_AGENT=PRISM/0.1.0 (personal research app; contact: your-address)
